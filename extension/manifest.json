{
  "manifest_version": 3,
  "name": "自主浏览器 · AI Browser Bridge",
  "version": "0.4.18",
  "description": "通过本机 MCP / CLI 将授权网页交给你选择的 AI，支持受限目录文件上传。无内置云模型。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "tabs", "debugger", "sidePanel", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "自主浏览器：连接与授权", "default_popup": "panel.html" },
  "options_page": "panel.html",
  "side_panel": { "default_path": "connect.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*" }
}





