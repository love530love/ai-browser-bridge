node_modules/
.local/
output/
dist/
*.zip
.ai-bridge/
.workbuddy/
.workbuddy-ai/
# Generated by install-autostart.ps1; contain this machine's node path.
bridge-autostart.vbs
bridge-autostart.cmd
# Local browser-session captures may contain private page data.
/_*.json
/vy_*.json
/tabs_tmp.json

# graphify code-graph output (generated, machine-local)
graphify-out/

# Last bench run, kept on disk for comparing versions. It holds no page data,
# but it is a timestamped measurement, not a source file.
test/bench/last-run.json
test/bench/surfaces-run.json

# Scratch files used while working; never commit these.
.tmp-*

# A 0-byte artefact named after a Windows reserved device. Win32 name parsing
# sends every normal delete to the NUL device, so it cannot be removed here;
# keep it out of the tree instead.
/nul

# Generated by scripts/native-host-register.ps1. The launcher hardcodes this
# machine's node path and the manifest hardcodes this machine's extension id,
# so both are install artefacts rather than source.
native-host/aibridge-host.bat
native-host/com.aibridge.host.json

# AEP collaboration area: machine-local multi-agent coordination state (mailbox, claims,
# leases, workspace marker). Shared over disk, not over git - the same convention
# agent-evolution-protocol uses for its own root. Never a product source file.
/.aep/workspace.json
/coordination/*
/.aep-kernel/
/AEP_JOIN.md
# The policy is the one hand-written file in that tree: machine-independent and not
# regenerable by `aep workspace-init`, so it is project config rather than local state.
# Git cannot re-include a file under a wholly ignored directory, hence `/coordination/*`.
!/coordination/PROJECT-POLICY.md
