{
  "name": "ai-browser-bridge",
  "version": "0.18.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node src/cli.js setup",
    "start": "node src/server.js",
    "status": "node src/cli.js status",
    "mcp": "node src/mcp.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:bench": "node test/bench/run.js",
    "test:e2e": "node test/browser-e2e.js",
    "test:stress": "node test/browser-stress.js",
    "test:devtools": "node test/live-devtools.js",
    "doctor": "node src/cli.js doctor",
    "test:capture": "node test/live-capture.js",
    "test:focus": "node test/focus-matrix.js",
    "test:session": "node test/live-session.js",
    "test:debugger": "node test/live-debugger.js",
    "test:native": "node test/live-native-action.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
